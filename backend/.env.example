# Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── MongoDB ───────────────────────────────────────────────
# Local: mongodb://localhost:27017/onionq
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/onionq
MONGODB_URI=mongodb://localhost:27017/onionq

# ─── Authentication ─────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── AI Service ────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── File Storage ──────────────────────────────────────────
# For local development, uploads go to ./uploads/
# For production, switch to S3 or equivalent.
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Future cloud storage (leave blank for local dev):
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
