# OnionQ AI Service Configuration

# YOLO Model Configuration
# Path to the trained OnionQ YOLO weights file (e.g. models/onion_best.pt).
# If the file does not exist, the service will start with model_loaded=false.
YOLO_MODEL_PATH=models/onion_best.pt

# Minimum detection confidence threshold (0.0 to 1.0)
YOLO_CONFIDENCE_THRESHOLD=0.25

# Input image size for YOLO inference (typically 640)
YOLO_IMAGE_SIZE=640

# Computation device: "cpu" or "cuda" (for GPU acceleration)
YOLO_DEVICE=cpu

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Max allowed upload size in Megabytes (default: 15)
MAX_UPLOAD_SIZE_MB=15
